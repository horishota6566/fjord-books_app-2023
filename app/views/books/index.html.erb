<p style="color: green"><%= notice %></p>

<h1><%= t('.heading') %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t('links.show', model: t('activerecord.models.book')), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t('links.new', model: t('activerecord.models.book')), new_book_path %>
</nav>
