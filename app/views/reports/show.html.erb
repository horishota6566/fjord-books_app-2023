<h1>Report</h1>

<div class="show-item">
  <%= render @report %>
</div>

<nav class="page-nav">
  <% if @report.user == current_user %>
    <%= link_to "Edit this report", edit_report_path(@report) %> |
    <%= link_to "Back to reports", reports_path %>
    <%= button_to "Destroy this report", @report, method: :delete %>
  <% else %>
      <%= link_to "Back to reports", reports_path %>
  <% end %>
</nav>

<h2>New Comment</h2>
<%= render 'comments/form', commentable: @report, comment: @comment %>

<% if @report.comments.present? %>
  <h2>Comments</h2>
  <%= render @report.comments %>
<% else %>
  <p>No comments yet.</p>
<% end %>
