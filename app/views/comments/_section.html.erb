<h2><%= t('views.common.title_new', name: Comment.model_name.human.downcase) %></h2>
<%= render 'comments/form', commentable: commentable, comment: comment %>

<% if comments.present? %>
  <h2><%= t('views.common.title_index', name: i18n_pluralize(Comment.model_name.human)) %></h2>
  <div id="comments" class="index-items">
    <% @comments.each do |comment| %>
      <div class="index-item">
        <%= render comment %>
      </div>
    <% end %>
  </div>

  <%= paginate comments %>
<% else %>
  <p>まだコメントがありません。</p>
<% end %>
